# geoextract serve configuration — copy to `.env` (gitignored) where the API runs.
#
# Login gate for the map AND the API (serve/auth.py). One password, no username.
# Unset = gate OFF (fine on a laptop); set = every route needs either the session
# cookie from /login or the password as a bearer token:
#   curl -H "Authorization: Bearer <password>" https://<host>/v1/companies?...
GEOEXTRACT_WEB_PASSWORD=

# Signs the session cookie. Any long random string; keep it stable so logins survive
# a restart (unset → generated per process, everyone is logged out on restart).
#   openssl rand -hex 32
GEOEXTRACT_WEB_SECRET=
